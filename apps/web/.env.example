# Model review is disabled unless all three server-side values are set.
# Create a private AI Gateway key; never expose it in NEXT_PUBLIC_* variables.
AI_GATEWAY_API_KEY=
# Gateway model ID selected by the deployment owner.
GRAPH_REVIEW_MODEL=
# Shared bearer token required for every billed POST /api/review request.
# Use a long random value and enter it in the review UI when explicitly requesting a review.
GRAPH_REVIEW_ACCESS_TOKEN=

# Optional Neo4j-backed graph workspace. GET /api/graph-store reports disabled until
# all required values are present. Use a dedicated database user with least privilege.
NEO4J_URI=
# Use the Neo4j HTTP origin (for example https://<instance>.databases.neo4j.io or
# http://localhost:7474), not a Bolt URI such as neo4j+s://… .
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# A fixed server-side namespace for this trusted workspace; callers cannot override it.
GRAPH_STORE_NAMESPACE=apexgraphswarm
# Shared bearer token required for every graph-store load or save request.
GRAPH_STORE_ACCESS_TOKEN=

# Optional integrations. All credentials and service endpoints are server-side only;
# never prefix these values with NEXT_PUBLIC_. GET /api/integrations exposes only
# non-secret capability/model metadata. Start and job-control requests require this token.
INTEGRATION_ACCESS_TOKEN=

# Direct model providers. OpenRouter uses its fixed official API origin. vLLM uses
# the configured OpenAI-compatible server; loopback HTTP is allowed for local dev only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
VLLM_BASE_URL=
VLLM_MODEL=
VLLM_API_KEY=

# Optional local AAH20 kernel sources. Configure roots only after placing the reviewed
# pinned repositories and sources.json manifest in .integration-sources/.
GRAPH_RAG_KERNEL_PATH=
AGENTIC_KERNEL_PATH=
MIROFISH_KERNEL_PATH=
GRAPH_SWARM_KERNEL_PATH=

# Optional authenticated / server-private remote frameworks. All operations require
# an explicit run; framework deployment IDs and scopes stay server-controlled.
COGNEE_BASE_URL=
COGNEE_DATASET=
COGNEE_API_KEY=
MIROFISH_BASE_URL=
LANGGRAPH_BASE_URL=
LANGGRAPH_ASSISTANT_ID=
LANGGRAPH_API_KEY=
CREWAI_BASE_URL=
CREWAI_TOKEN=
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=

# Optional trusted local CLI bridge. Subscription auth selects an enabled local profile;
# it is not an API key or unlimited API entitlement. The bridge only launches fixed
# server-enabled argv profiles and is not auto-started by Next.js.
LOCAL_RUNNER_URL=http://127.0.0.1:8765
LOCAL_RUNNER_ACCESS_TOKEN=

# Optional read-only discovery of fixed MCP Streamable HTTP server profiles.
# POST /api/ecosystem/mcp initializes and lists tools only; it never calls tools/call.
# Configure fixed endpoint URLs in MCP_SERVERS_JSON and refer to server tokens by env name.
# Supported: HTTPS or HTTP loopback in local development; maximum 8 server profiles.
MCP_SERVERS_JSON=[]
MCP_SERVER_TEAM_GATEWAY_TOKEN=

# Durable adapter dispatch: enroll the worker using the local control CLI first.
# The returned one-time credential is private; enrollment is not a browser action.
APEX_WORKER_ID=
APEX_WORKER_CREDENTIAL=
# Optional absolute SQLite path; default repository .runtime/control.sqlite.
APEX_CONTROL_DB_PATH=
# Exact operation/resource/model policies; see docs/durable-adapters.md.
APEX_INTEGRATION_POLICIES_JSON=[]

# Optional read-only vLLM Prometheus endpoint for the Optimization Lab.
# HTTPS or loopback HTTP; payloads cannot override the server configuration.
VLLM_METRICS_URL=
VLLM_METRICS_TOKEN=

# Optional operator-selected local Git repository for read-only conflict planning.
# Browser requests cannot override this path. Defaults to this ApexGraphSwarm checkout.
APEX_REPOSITORY_PATH=

# Optional typed decision services (separate runtimes; never NEXT_PUBLIC secrets).
# Exact Laya endpoint from laya-serve; configure API auth in the service too.
LAYA_PREDICT_URL=
LAYA_API_KEY=
# Operator-entered conservative estimate per question, integer micro-USD.
# Calibrate for maximum option count/context: AnyJev L0 may use multiple prefills.
# Leave unset to disable execution. Explicit zero means an estimate, not free compute.
LAYA_COST_MICROUSD_PER_QUESTION=
# ApexGraphSwarm optional AnyJev bridge endpoint, not a native upstream API.
ANYJEV_PREDICT_URL=
ANYJEV_API_KEY=
ANYJEV_COST_MICROUSD_PER_QUESTION=
